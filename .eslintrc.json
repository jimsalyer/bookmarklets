{
  "env": {
    "browser": true,
    "es2021": true,
    "jest": true,
    "node": true,
    "shared-node-browser": true
  },
  "parserOptions": {
    "ecmaVersion": 2021,
    "sourceType": "module"
  },
  "extends": ["eslint:recommended", "prettier"],
  "rules": {
    "no-delete-var": "warn",
    "no-unused-vars": "warn",
    "strict": ["error", "never"]
  },
  "overrides": [
    {
      "files": ["jest.config.cjs"],
      "parserOptions": {
        "sourceType": "script"
      },
      "rules": {
        "strict": ["error", "global"]
      }
    }
  ]
}
